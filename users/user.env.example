# Copy to users/<id>.env  (e.g. users/a.env) — never commit real tokens.
BROKER=upstox

# --- Upstox (live muhurat orders) ---
UPSTOX_ACCESS_TOKEN=
UPSTOX_STATIC_IP_PRIMARY=
UPSTOX_STATIC_IP_SECONDARY=

# --- Angel One (optional / future) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
ANGEL_JWT_TOKEN=

# --- Muhurat money (per user) ---
MUHURAT_BUDGET=20000
MUHURAT_BUDGET_STOCK=5000
MUHURAT_BUDGET_OPTIONS=15000
MUHURAT_LIVE=true
MUHURAT_LIVE_CONFIRM=I_ACCEPT_REAL_ORDERS
MUHURAT_PRODUCT=I
