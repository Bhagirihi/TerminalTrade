# --- MegaBull paper trading (virtual money only) ---
# https://megabull.in/paper-trading-api-india.html
MEGABULL_API_KEY=4b40e3a0-fc5a-40f1-b12c-f33b8e31973b
MEGABULL_PAPER=true

# Muhurat / day-trade cash plan
# regular = normal NSE day 9:15–3:15 | muhurat = special 2:20–3:15 window
MUHURAT_SESSION=regular
MUHURAT_BUDGET=20000
# Max new BUY trades per day (0 = unlimited).
MUHURAT_MAX_TRADES_STOCK=5
MUHURAT_MAX_TRADES_OPTIONS=2
# Name must stay in top Live pool this many seconds before using a trade slot (anti-flicker).
MUHURAT_CONFIRM_SEC=180
# Step profit-lock trail (muhurat2 / muhurat).
# Stocks: arm +2.5% (hold 30s) → lock +1.5%; then +1% steps.
MUHURAT_STOCK_ARM_PCT=2.5
MUHURAT_STOCK_LOCK_PCT=1.5
MUHURAT_STOCK_STEP_PCT=1
MUHURAT_STOCK_ARM_HOLD_SEC=30
# Options: +5% → cost; +10% → +10% floor; then +5% steps.
MUHURAT_OPT_BE_PCT=5
MUHURAT_OPT_LOCK_FIRST_PCT=10
MUHURAT_OPT_STEP_PCT=5
MUHURAT_TRAIL=step
# Live mode available — still requires typing YES at start before any BUY.
MUHURAT_LIVE=true
MUHURAT_LIVE_CONFIRM=I_ACCEPT_REAL_ORDERS
MUHURAT_PRODUCT=I
# Block new trades when book loss ≥ this % (near 20% rule).
MUHURAT_NO_TRADE_LOSS_PCT=18
# MUHURAT_BUY_APPROVED is set only for the current process after you type YES.
