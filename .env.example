# Copy this file to ".env" and fill in your values. Never commit .env.
# The project uses Upstox and Angel One SmartAPI for realtime data.

# --- Data source selection ---
# auto     = Upstox first, Angel One as failover (both realtime)
# upstox   = only Upstox
# angelone = only Angel One
DATA_SOURCE=auto

# --- Upstox ---
# App credentials from the Upstox developer console.
UPSTOX_API_KEY=96099425-b806-4f22-80da-2af2ba7f84cd
UPSTOX_API_SECRET=viiy6a64r0
# Must match the redirect URL registered on the Upstox app.
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/callback
# Filled by `npm run login`. Expires at midnight IST.
UPSTOX_ACCESS_TOKEN=eyJ0eXAiOiJKV1QiLCJrZXlfaWQiOiJza192MS4wIiwiYWxnIjoiSFMyNTYifQ.eyJzdWIiOiI2OTk0NzAiLCJqdGkiOiI2YWYxNDdiM2Y3YTU5NTdjYWJjNzBkNjMiLCJpc011bHRpQ2xpZW50IjpmYWxzZSwiaXNQbHVzUGxhbiI6ZmFsc2UsImlhdCI6MTc5NDE5NzQyNywiaXNzIjoidWRhcGktZ2F0ZXdheS1zZXJ2aWNlIiwiZXhwIjoxNzk0MjYxNjAwfQ.1M8NlyJXYXy4vTagoYG1Ga27EmkThjW7IIXoLiTaifk

# --- Angel One SmartAPI ---
# Create an app at smartapi.angelone.in to get the API key.
# Either paste a ready JWT (ANGEL_JWT_TOKEN), or fill all four login values
# and the project will log in itself (client code + password + TOTP secret
# from your Angel One TOTP setup).
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
ANGEL_JWT_TOKEN=

# --- Strategy / app ---
# Candle timeframe in minutes (the strategy was built for intraday; 15 default)
TIMEFRAME_MINUTES=15
PORT=3000
POLL_SECONDS=20

# --- Gemini ---
# Commentary on the holdings screen only. This file is gitignored.
GEMINI_API_KEY=AIzaSyD_Uk3kJh0D590z4Rg7DJzzs7h_zEULAqo
GEMINI_API_KEY_2=AIzaSyBZCiGRwotGVWn2WL1NaEuGiWTg-uwr3a8
