# Upstox login — copy this file to ".env" and fill in your values. Never commit .env.
# App credentials from the Upstox developer console.
UPSTOX_API_KEY=<your-upstox-api-key>
UPSTOX_API_SECRET=<your-upstox-api-secret>
# CLI login (`npm run login`) callback — must match a redirect URL registered on your Upstox app.
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/callback
# Filled by `npm run login`.
UPSTOX_ACCESS_TOKEN=
# After login, the browser opens this URL (optional — defaults to the preferred host on :3001).
# MUHURAT_AFTER_LOGIN_URL=http://127.0.0.1:3001/
