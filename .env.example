# Copy this file to ".env" and fill in your values. Never commit .env.
# The project uses Upstox and Angel One SmartAPI for realtime data.

# --- Data source selection ---
# auto     = Upstox first, Angel One as failover (both realtime)
# upstox   = only Upstox
# angelone = only Angel One
DATA_SOURCE=auto

# --- Upstox ---
# App credentials from the Upstox developer console.
UPSTOX_API_KEY=96099425-b806-4f22-80da-2af2ba7f84cd
UPSTOX_API_SECRET=viiy6a64r0
# CLI login (`npm run login`) callback — must match an Upstox app redirect URL.
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/callback
# Web UI “Link Upstox” callback (register this on the Upstox app too):
# UPSTOX_WEB_REDIRECT_URI=http://130.210.26.188:3000/auth/upstox/callback
# Filled by `npm run login`, muhurat2 auto-login, or the web Link Upstox button.
# MUHURAT_AFTER_LOGIN_URL=http://130.210.26.188:3000/
UPSTOX_ACCESS_TOKEN=
# Must match Upstox developer app → Static IPs (orders 403 if egress IP differs).
UPSTOX_STATIC_IP_PRIMARY=130.210.26.188
UPSTOX_STATIC_IP_SECONDARY=171.61.162.154
# Optional: HTTP(S) proxy that exits on the primary static IP (VPN/VPS).
# UPSTOX_HTTPS_PROXY=http://127.0.0.1:7890

# --- Angel One SmartAPI ---
# Create an app at smartapi.angelone.in to get the API key.
# Either paste a ready JWT (ANGEL_JWT_TOKEN), or fill all four login values
# and the project will log in itself (client code + password + TOTP secret
# from your Angel One TOTP setup).
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
ANGEL_JWT_TOKEN=

# --- Strategy / app ---
# Candle timeframe in minutes (the strategy was built for intraday; 15 default)
TIMEFRAME_MINUTES=15
PORT=3000
# Muhurat2 browser UI (default 3000 — same as PORT unless MUHURAT_WEB_PORT is set)
# MUHURAT_WEB_PORT=3000
# Public/Oracle host for UI links + post-login redirect (defaults to UPSTOX_STATIC_IP_PRIMARY).
MUHURAT_WEB_HOST=130.210.26.188
POLL_SECONDS=20

# --- Gemini ---
# Commentary on the holdings screen only. This file is gitignored.
GEMINI_API_KEY=AIzaSyD_Uk3kJh0D590z4Rg7DJzzs7h_zEULAqo
GEMINI_API_KEY_2=AIzaSyBZCiGRwotGVWn2WL1NaEuGiWTg-uwr3a8
GEMINI_API_KEY_3=AIzaSyBJvZcrhZYYPqa54KAy8bCQ4v06Gp-5Ook

# --- MegaBull paper trading (virtual money only) ---
# https://megabull.in/paper-trading-api-india.html
MEGABULL_API_KEY=4b40e3a0-fc5a-40f1-b12c-f33b8e31973b
MEGABULL_PAPER=true

# Muhurat / day-trade cash plan
# regular = normal NSE day 9:15–3:15 | muhurat = special 2:20–3:15 window
MUHURAT_SESSION=regular
MUHURAT_BUDGET=20000
# Optional defaults for merged mode (`npm run muhurat2` / --both). Prompt can override.
MUHURAT_BUDGET_STOCK=15000
# Options: 1 NIFTY lot often needs ₹15k–₹40k+ premium×65 — keep this high enough.
MUHURAT_BUDGET_OPTIONS=25000
# Options lot rule (1-lot cost = LTP × lot size): below ₹5k → 2 lots; else 1 lot (incl. >₹10k).
# MUHURAT_OPT_TWO_LOT_BELOW=5000
# MUHURAT_OPT_ONE_LOT_FROM=10000
# Max new BUY trades per day (0 = unlimited).
MUHURAT_MAX_TRADES_STOCK=5
MUHURAT_MAX_TRADES_OPTIONS=2
# Name must stay in top Live pool this many seconds before using a trade slot (anti-flicker).
MUHURAT_CONFIRM_SEC=60
# Step profit-lock trail (muhurat2 / muhurat).
# Stocks: arm +2.5% (hold 30s) → lock +1.5%; then +1% steps.
MUHURAT_STOCK_ARM_PCT=2.5
MUHURAT_STOCK_LOCK_PCT=1.5
MUHURAT_STOCK_STEP_PCT=1
MUHURAT_STOCK_ARM_HOLD_SEC=30
# Options: +5% → cost; +10% → +10% floor; then +5% steps.
MUHURAT_OPT_BE_PCT=5
MUHURAT_OPT_LOCK_FIRST_PCT=10
MUHURAT_OPT_STEP_PCT=5
MUHURAT_TRAIL=step
# Live mode available — still requires typing YES at start before any BUY.
MUHURAT_LIVE=true
MUHURAT_LIVE_CONFIRM=I_ACCEPT_REAL_ORDERS
MUHURAT_PRODUCT=I
# Block new trades when book loss ≥ this % (near 20% rule).
MUHURAT_NO_TRADE_LOSS_PCT=18
# MUHURAT_BUY_APPROVED is set only for the current process after you type YES.
